configuration {
    show-icons: false;
    matching: "normal";
    sorting-method: "normal";
    cycle: true;
}

@import "~/.config/rofi/colors/colors-matugen.rasi"

* {
    font: "JetBrainsMono Nerd Font Propo 32";
    background-soft: #1f232cff;
    danger: #e06c75ff;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: true;
    background-color: rgba(0, 0, 0, 0.7);
}

mainbox {
    padding: 0px;
    spacing: 0px;
    margin: 35% 10%;
    background-color: transparent;
    children: [ "listview" ];
}

/* Kept defined but dropped from mainbox's children below: the menu rows are
   bare icons now, so there is no label text left to type-filter against and a
   live entry would only let a stray keystroke filter the row down to nothing.
   Navigation is arrow keys + Enter. To restore type-to-filter, put "inputbar"
   back in mainbox { children } and give each row its label text again. */
inputbar {
    enabled: true;
    font: "JetBrainsMono Nerd Font 1";
    padding: 0px;
    margin: 0px;
    spacing: 0px;
    background-color: transparent;
    text-color: transparent;
    children: [ "entry" ];
}

entry {
    enabled: true;
    font: "JetBrainsMono Nerd Font 1";
    padding: 0px;
    margin: 0px;
    background-color: transparent;
    text-color: transparent;
    cursor: text;
    placeholder: "";
}

listview {
    lines: 1;
    columns: 5;
    fixed-height: true;
    dynamic: true;
    scrollbar: false;
    spacing: 30px;
    background-color: transparent;
}

element {
    padding: 60px 0px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.1);
    text-color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
}

element selected.normal {
    background-color: @selected;
    text-color: @background;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: pointer;
}
