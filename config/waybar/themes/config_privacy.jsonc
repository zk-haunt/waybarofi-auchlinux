{
    // ── Privacy Waybar Theme ──────────────────────────────────────────────── //
    // Features dedicated PipeWire privacy indicators (screenshare, microphone,
    // and audio-out), live camera access detection, and screen recording alerts.
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

    "modules-left": [
        "hyprland/workspaces",
        "custom/sep",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "privacy",
        "custom/camera",
        "custom/screenrecord",
        "custom/sep",
        "cpu",
        "memory",
        "custom/sep",
        "pulseaudio",
        "pulseaudio#microphone",
        "custom/sep",
        "network",
        "battery",
        "tray"
    ],

    // ── Privacy & Security Modules ────────────────────────────────────────── //
    "privacy": {
        "icon-spacing": 6,
        "icon-size": 14,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-out",
                "tooltip": true,
                "tooltip-icon-size": 24
            }
        ]
    },

    "custom/camera": {
        "exec": "$HOME/auchlinux/config/waybar/scripts/camera-privacy.sh",
        "return-type": "json",
        "interval": 2,
        "hide-empty-text": true,
        "tooltip": true
    },

    "custom/screenrecord": {
        "exec": "pgrep -x wf-recorder >/dev/null && echo '{\"text\":\"󰻂 REC\",\"class\":\"recording\",\"tooltip\":\"Screen Recording Active (click to stop)\"}' || echo '{\"text\":\"\",\"class\":\"\",\"tooltip\":\"\"}'",
        "interval": 2,
        "signal": 9,
        "return-type": "json",
        "hide-empty-text": true,
        "on-click": "pkill -INT -x wf-recorder"
    },

    "custom/sep": {
        "format": "│",
        "tooltip": false
    },

    // ── Desktop & Window Modules ──────────────────────────────────────────── //
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{name}",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 3
        }
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 45,
        "separate-outputs": true,
        "offscreen-css": true,
        "offscreen-css-text": "(inactive)"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %B %d, %Y (%R)}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#89b4fa'><b>{}</b></span>",
                "today": "<span color='#a6e3a1'><b>{}</b></span>",
                "weeks": "<span color='#b4befe'><b>{}</b></span>"
            }
        }
    },

    // ── System Resource Monitors ──────────────────────────────────────────── //
    "cpu": {
        "format": " {usage}%",
        "tooltip": true,
        "tooltip-format": "CPU Usage: {usage}%\nLoad: {load}",
        "interval": 2,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": " {percentage}%",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G ({swapPercentage}%)",
        "interval": 5,
        "on-click": "kitty -e btop"
    },

    // ── Audio Controls ────────────────────────────────────────────────────── //
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "",
            "headset": "󰋋",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol-qt -t 3 || pavucontrol -t 3",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip-format": "{desc} — {volume}%"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": "",
        "on-click": "pavucontrol-qt -t 4 || pavucontrol -t 4",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{source_desc} (Mic: {source_volume}%)"
    },

    // ── Hardware & Network ────────────────────────────────────────────────── //
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-linked": "󰈀 {ifname}",
        "format-disconnected": "󰖪 Off",
        "tooltip-format": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nSignal: {signalStrength}%",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
